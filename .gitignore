# --- Datos ---
# Ignora los datos crudos y procesados (pesados o no redistribuibles).
# Si quieres versionar una MUESTRA pequeña, añade una excepción abajo.
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

